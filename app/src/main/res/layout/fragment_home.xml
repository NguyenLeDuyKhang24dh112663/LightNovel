<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/myBgColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/secHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F4A62A"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trang chủ"
                android:textColor="@color/black"
                android:textStyle="bold|italic"
                android:padding="10dp"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat_medium"/>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ImageButton
                android:id="@+id/btnBannerLeft"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_bg_semi_transparent"
                android:src="@drawable/abc_ic_ab_back_material"
                app:tint="@color/white"
                android:elevation="4dp" />

            <ImageButton
                android:id="@+id/btnBannerRight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_bg_semi_transparent"
                android:rotation="180"
                android:src="@drawable/abc_ic_ab_back_material"
                app:tint="@color/white"
                android:elevation="4dp" />
        </FrameLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/montserrat_medium"
                android:text="Mới Nhất"
                android:textColor="@color/Red"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Dropdown thể loại -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/menuGenres"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:hintEnabled="false"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:boxBackgroundColor="@color/HintColor"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent">

<!--                Khối chọn   -->
                <AutoCompleteTextView
                    android:id="@+id/autoCompleteGenres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="Tất cả"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:popupBackground="@color/BeigeBrown"
                    app:dropDownBackgroundTint="@color/BeigeBrown" />

            </com.google.android.material.textfield.TextInputLayout>
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="8dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
