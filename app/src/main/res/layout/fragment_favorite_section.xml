<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/myBgColor"
    tools:context=".FavoriteSectionFragment">

    <LinearLayout
        android:id="@+id/secHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F4A62A"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Truyện yêu thích"
            android:textColor="@color/black"
            android:textStyle="bold|italic"
            android:padding="10dp"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_medium"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvEmptyFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:fontFamily="@font/montserrat_medium"
            android:text="Hiện tại không có truyện yêu thích."
            android:textColor="@color/HintColor"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>