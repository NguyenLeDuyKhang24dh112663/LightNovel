<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">


        <!-- ====== Phần trên: Ảnh + Thông tin ====== -->

        <!-- ====== Giới thiệu ====== -->

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#F4A62A"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"

            android:title="Gấu Truyện/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Ảnh bìa -->

            <ImageView
                android:id="@+id/imgDetail"
                android:layout_width="120dp"
                android:layout_height="170dp"
                android:layout_marginEnd="16dp"
                android:background="@android:color/darker_gray"
                android:scaleType="centerCrop" />

            <!-- Thông tin -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Tên truyện"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTrangThai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Đang tiến hành"
                    android:textColor="#BDBDBD" />

                <TextView
                    android:id="@+id/txtTacGia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Tác giả: ..."
                    android:textColor="#BDBDBD" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/BgThemeColor"

                android:layout_gravity="bottom"
                app:srcCompat="@drawable/ic_baseline_favorite_border_24" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:text="Giới thiệu"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/txtMoTa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:text="Mô tả truyện ở đây..."
            android:textColor="#CCCCCC"
            android:layout_marginTop="8dp"/>

        <!-- ====== Nút đọc ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnViewChapters"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Xem các chương"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="match_parent"/>

            <Button
                android:id="@+id/btnContinue"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:fontFamily="@font/montserrat_medium"
                android:layout_weight="1"
                android:text="Đọc tiếp"
                android:backgroundTint="#795548"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <!-- ====== Nút Share ====== -->
            <Button
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="⬆ Chia sẻ truyện"
                android:backgroundTint="#37474F"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnCmts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bình luận" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>