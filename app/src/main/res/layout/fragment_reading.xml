<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/myBgColor"
    tools:context=".ReadingFragment">

    <!-- Danh sách chương (Mặc định hiện) -->
    <LinearLayout
        android:id="@+id/layoutChapterList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/BgThemeColor1">

            <ImageButton
                android:id="@+id/btnBackToDetail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:src="@drawable/abc_ic_ab_back_material"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tvReadingNovelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnBackToDetail"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="Danh sách chương"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChaptersList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Nội dung chương (Ẩn đi, hiện khi chọn chương) -->
    <LinearLayout
        android:id="@+id/layoutChapterContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCurrentChapterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F4A62A"
            android:gravity="center"
            android:padding="16dp"
            android:text="Nội dung"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvContent"
                android:fontFamily="@font/montserrat_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="8dp"
                android:padding="16dp"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#121212">

            <ImageButton
                android:id="@+id/ivBack"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/abc_ic_ab_back_material"
                app:tint="@color/HintColor"
                android:contentDescription="Quay lại danh sách"/>

            <Button
                android:id="@+id/btnMoveToTop"
                android:fontFamily="@font/montserrat_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginHorizontal="4dp"
                android:text="Lên đầu"
                android:backgroundTint="@color/Blue"/>

            <Button
                android:id="@+id/btnMoveToBottom"
                android:fontFamily="@font/montserrat_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="4dp"
                android:text="Xuống cuối"
                android:backgroundTint="@color/Green"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
